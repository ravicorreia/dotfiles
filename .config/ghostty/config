# ╭─────────────────────────────────────────────────────╮
# │  Ghostty — macOS config                             │
# │  ~/.config/ghostty/config                           │
# ╰─────────────────────────────────────────────────────╯


# ── Font ──────────────────────────────────────────────
font-family            = JetBrainsMono Nerd Font
font-size              = 13
font-style             = Regular
font-style-bold        = Bold
font-style-italic      = Italic
font-style-bold-italic = Bold Italic
font-thicken           = true          # Cleaner rendering on Retina


# ── Transparency & Blur ───────────────────────────────
background-opacity    = 0.88
background-blur-radius = 32            # macOS vibrancy blur


# ── Window ────────────────────────────────────────────
macos-titlebar-style  = tabs           # Native tab bar, no ugly titlebar
window-padding-x      = 14
window-padding-y      = 12
window-padding-balance = true          # Equal padding around content
window-width          = 220
window-height         = 50


# ── Cursor ────────────────────────────────────────────
cursor-style          = bar
cursor-style-blink    = smooth
cursor-color          = #89b4fa        # Soft blue, stands out on any bg


# ── Shell ─────────────────────────────────────────────
shell-integration          = detect
shell-integration-features = cursor,sudo,title


# ── Colors — Catppuccin Mocha ─────────────────────────
# A dark, desaturated palette that pairs well with transparency

background  = #1e1e2e
foreground  = #cdd6f4

# Black
palette = 0=#45475a
palette = 8=#585b70

# Red
palette = 1=#f38ba8
palette = 9=#f38ba8

# Green
palette = 2=#a6e3a1
palette = 10=#a6e3a1

# Yellow
palette = 3=#f9e2af
palette = 11=#f9e2af

# Blue
palette = 4=#89b4fa
palette = 12=#89b4fa

# Magenta
palette = 5=#cba4f7
palette = 13=#cba4f7

# Cyan
palette = 6=#94e2d5
palette = 14=#94e2d5

# White
palette = 7=#bac2de
palette = 15=#a6adc8

selection-background = #313244
selection-foreground = #cdd6f4


# ── Keybinds ──────────────────────────────────────────
# macOS-friendly overrides
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+enter=toggle_fullscreen


# ── Misc ──────────────────────────────────────────────
copy-on-select          = false
confirm-close-surface   = false        # No popup when closing a tab
mouse-hide-while-typing = true
scrollback-limit        = 10000
auto-update             = check        # Notify only, don't auto-install
